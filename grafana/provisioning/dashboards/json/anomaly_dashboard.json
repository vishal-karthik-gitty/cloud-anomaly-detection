{
  "title": "Cloud Anomaly Detection — SOC Overview",
  "uid": "anomaly-detection-overview",
  "timezone": "browser",
  "refresh": "5s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Anomalies Detected (by severity)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(anomaly_api_anomalies_detected_total[1m])) by (severity)",
          "legendFormat": "{{severity}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Total Requests / Normal / Anomalies",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "anomaly_api_requests_total", "legendFormat": "Total Requests" },
        { "expr": "anomaly_api_normal_total", "legendFormat": "Normal" },
        { "expr": "sum(anomaly_api_anomalies_detected_total)", "legendFormat": "Anomalies" }
      ]
    },
    {
      "id": 3,
      "title": "Prediction Latency (p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(anomaly_api_request_latency_seconds_bucket[5m]))",
          "legendFormat": "p95 latency (s)"
        }
      ]
    },
    {
      "id": 4,
      "title": "Anomaly Rate (% of requests)",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "100 * sum(anomaly_api_anomalies_detected_total) / anomaly_api_requests_total",
          "legendFormat": "Anomaly %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "steps": [
              { "value": 0, "color": "green" },
              { "value": 5, "color": "orange" },
              { "value": 15, "color": "red" }
            ]
          }
        }
      }
    }
  ]
}
